@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome

title UTMS 高校教学管理系统用例图

left to right direction

actor "学生" as Student
actor "教师" as Teacher
actor "教务员" as Staff
actor "管理员" as Admin

rectangle "高校教学管理系统" {
    package "个人信息" {
        usecase "查看个人信息" as UC_ViewInfo
        usecase "修改个人信息" as UC_EditInfo
    }

    package "学生管理" {
        usecase "新增学生" as UC_AddStudent
        usecase "查询学生" as UC_SearchStudent
        usecase "编辑学生" as UC_EditStudent
        usecase "删除学生" as UC_DeleteStudent
        usecase "查询同班同学" as UC_SearchClassmate
    }

    package "教师管理" {
        usecase "新增教师" as UC_AddTeacher
        usecase "查询教师" as UC_SearchTeacher
        usecase "编辑教师" as UC_EditTeacher
        usecase "删除教师" as UC_DeleteTeacher
    }

    package "专业与班级管理" {
        usecase "新增专业" as UC_AddMajor
        usecase "查询专业" as UC_SearchMajor
        usecase "编辑专业" as UC_EditMajor
        usecase "删除专业" as UC_DeleteMajor
        usecase "新增班级" as UC_AddClasses
        usecase "查询班级" as UC_SearchClasses
        usecase "编辑班级" as UC_EditClasses
        usecase "删除班级" as UC_DeleteClasses
    }

    package "课程管理" {
        usecase "新增课程" as UC_AddSubject
        usecase "查询课程" as UC_SearchSubject
        usecase "编辑课程" as UC_EditSubject
        usecase "删除课程" as UC_DeleteSubject
        usecase "班级排课" as UC_PlanClassSubject
        usecase "导出班级课表" as UC_ExportSchedule
    }

    package "成绩管理" {
        usecase "查询成绩" as UC_SearchScore
        usecase "录入/更新成绩" as UC_UpdateScore
        usecase "成绩统计分析" as UC_ScoreStats
    }

    package "系统管理" {
        usecase "用户管理" as UC_UserManage
        usecase "权限管理" as UC_PrivilegeManage
        usecase "登录" as UC_Login
        usecase "注销" as UC_Logout
    }
}

' 学生权限
Student --> UC_Login
Student --> UC_Logout
Student --> UC_ViewInfo
Student --> UC_EditInfo
Student --> UC_SearchClassmate
Student --> UC_SearchSubject
Student --> UC_SearchScore

' 教师权限
Teacher --> UC_Login
Teacher --> UC_Logout
Teacher --> UC_ViewInfo
Teacher --> UC_EditInfo
Teacher --> UC_SearchStudent
Teacher --> UC_SearchClasses
Teacher --> UC_SearchSubject
Teacher --> UC_SearchScore
Teacher --> UC_UpdateScore

' 教务员权限（与管理员合并）
Staff --> UC_AddStudent
Staff --> UC_AddTeacher
Staff --> UC_AddSubject
Staff --> UC_AddMajor
Staff --> UC_AddClasses
Staff --> UC_EditMajor
Staff --> UC_EditClasses
Staff --> UC_PlanClassSubject
Staff --> UC_ScoreStats

' 管理员权限
Admin --> UC_UserManage
Admin --> UC_PrivilegeManage

' 管理员继承教务员
Admin --> UC_AddStudent
Admin --> UC_AddTeacher
Admin --> UC_AddSubject
Admin --> UC_AddMajor
Admin --> UC_AddClasses
Admin --> UC_EditMajor
Admin --> UC_EditClasses
Admin --> UC_PlanClassSubject
Admin --> UC_ScoreStats

' 包含/扩展关系
UC_PlanClassSubject ..> UC_SearchClasses : <<include>>
UC_PlanClassSubject ..> UC_SearchSubject : <<include>>
UC_ScoreStats ..> UC_SearchScore : <<include>>
UC_UpdateScore ..> UC_SearchScore : <<include>>

note right of UC_ScoreStats
    任务7新增功能：
    平均分、及格率、
    分段分布图、分科目统计
end note

@enduml