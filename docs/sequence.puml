@startuml
skinparam sequenceArrowThickness 2
skinparam participantPadding 20

title 学生用户查询课程和成绩顺序图（任务4）

actor "学生" as User
participant "浏览器" as Browser
participant "login.jsp/\nindex.jsp" as View
participant "LoginFilter" as Filter
participant "SearchScore\nServlet" as ScoreServlet
participant "ScoreImpl" as ScoreImpl
participant "StudentImpl" as StudentImpl
participant "DB" as DB
participant "MySQL" as MySQL

group 登录与权限校验
    User -> Browser : 输入账号密码
    Browser -> View : POST /LoginServlet
    View -> Filter : 登录验证
    Filter -> DB : 查询 operator
    DB -> MySQL : SELECT
    MySQL --> DB : 返回用户角色
    DB --> Filter : Operator + Role
    Filter --> View : 设置 session
    View --> Browser : 跳转学生主界面
end

group 查询课程
    User -> Browser : 点击"课程查询"
    Browser -> View : 加载 search_subject.jsp
    View -> Filter : 权限检查（role=3）
    Filter --> View : 通过
    View --> Browser : 返回课程查询页面
    User -> Browser : 点击查询
    Browser -> ScoreServlet : AJAX 查询（可选）
end

group 查询成绩
    User -> Browser : 点击"成绩查询"
    Browser -> View : 加载 search_score.jsp
    View -> Filter : 权限检查（role=3）
    Filter --> View : 通过
    View --> Browser : 返回成绩查询页面
    User -> Browser : 选择查询条件并点击查询
    Browser -> ScoreServlet : AJAX POST /SearchScoreServlet
    ScoreServlet -> ScoreServlet : 从 session 获取当前学生
    ScoreServlet -> StudentImpl : query("ope_id", operator.id)
    StudentImpl -> DB : getConn()
    DB -> MySQL : SELECT * FROM student
    MySQL --> DB : 返回学生记录
    DB --> StudentImpl : Student 对象
    StudentImpl --> ScoreServlet : List<Student>
    ScoreServlet -> ScoreImpl : query("stu_id", student.id)
    ScoreImpl -> DB : getConn()
    DB -> MySQL : SELECT * FROM score JOIN subject
    MySQL --> DB : 返回成绩记录
    DB --> ScoreImpl : ResultSet
    ScoreImpl --> ScoreServlet : List<Score>
    ScoreServlet --> Browser : JSON 数据
    Browser --> User : 渲染成绩列表
end

@enduml